# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env

# ---- ระบบ ----
PORT=4000
JWT_SECRET=เปลี่ยนเป็นข้อความสุ่มยาว-ๆ
# true = โหมดสาธิต (มีปุ่มเลื่อนวันที่จำลอง, กรอกค่ามิเตอร์ตัวอย่าง)  false = ใช้วันที่จริง + cron ทุกวัน 00:05
DEMO_MODE=true
DAILY_JOB_CRON=5 0 * * *

# ---- ฐานข้อมูลและ ML (ถ้ารันแบบ docker compose ค่านี้ถูกกำหนดให้แล้ว) ----
DATABASE_URL=postgresql://market:market@localhost:5432/market
ML_URL=http://localhost:8000

# ---- Payment Gateway: Omise (Opn Payments) ----
# เว้นว่าง = ใช้ผู้ให้บริการจำลอง (mock) ระบบยังทำงานครบทุกขั้นตอน
# สมัครบัญชีทดสอบที่ https://dashboard.omise.co แล้วคัดลอก Test keys (ขึ้นต้นด้วย pkey_test_ / skey_test_)
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# บังคับเลือก provider เอง: omise | mock (ปกติไม่ต้องตั้ง)
# PAYMENT_PROVIDER=
